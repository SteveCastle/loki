shaders = 4

# Pass 0 - float copy; its mip chain feeds the blur passes.
shader0        = prep.slang
filter_linear0 = true
scale_type0    = source
scale0         = 1.0
wrap_mode0     = clamp_to_edge
float_framebuffer0 = true

# Passes 1-2 - separable Gaussian whose sigma grows away from the band.
shader1        = blur_h.slang
filter_linear1 = true
mipmap_input1  = true
scale_type1    = source
scale1         = 1.0
wrap_mode1     = clamp_to_edge
float_framebuffer1 = true

shader2        = blur_v.slang
filter_linear2 = true
mipmap_input2  = true
scale_type2    = source
scale2         = 1.0
wrap_mode2     = clamp_to_edge
float_framebuffer2 = true

# Pass 3 - focus pop + mix against the clean Original.
shader3        = tilt-shift.slang
filter_linear3 = true
scale_type3    = viewport
scale3         = 1.0
wrap_mode3     = clamp_to_edge

parameters = "radius;amount;focus;band;softness;pop"
radius   = 4.0
amount   = 1.0
focus    = 0.5
band     = 0.16
softness = 0.18
pop      = 0.4
