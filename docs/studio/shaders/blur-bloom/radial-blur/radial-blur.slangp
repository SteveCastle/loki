shaders = 2

# Pass 0 - fine zoom smear over the first 1/24 of the range (float, so the
# final average of 24 of these doesn't band).
shader0        = zoom_fine.slang
filter_linear0 = true
scale_type0    = source
scale0         = 1.0
wrap_mode0     = clamp_to_edge
float_framebuffer0 = true

# Pass 1 - 24 coarse zoom taps + mix against the clean Original.
shader1        = radial-blur.slang
filter_linear1 = true
scale_type1    = viewport
scale1         = 1.0
wrap_mode1     = clamp_to_edge

parameters = "amount;strength;center_x;center_y;falloff"
