shaders = 3

# Pass 0 - copy (optionally linearized) into a float, mipmapped buffer.
shader0        = prep.slang
filter_linear0 = true
scale_type0    = source
scale0         = 1.0
wrap_mode0     = clamp_to_edge
# Float framebuffers throughout: an 8-bit intermediate re-quantizes the
# smooth gradient the blur just created - that is where banding comes from.
float_framebuffer0 = true

# Pass 1 - horizontal Gaussian, sampling the mip level matched to sigma.
shader1        = blur_h.slang
filter_linear1 = true
mipmap_input1  = true
scale_type1    = source
scale1         = 1.0
wrap_mode1     = clamp_to_edge
float_framebuffer1 = true

# Pass 2 - vertical Gaussian + mix against the clean Original.
shader2        = gaussian-blur.slang
filter_linear2 = true
mipmap_input2  = true
scale_type2    = viewport
scale2         = 1.0
wrap_mode2     = clamp_to_edge

parameters = "amount;radius;aspect;linlight"
amount = 1.0
radius = 3.0
aspect = 0.0
linlight = 0.0
